<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Album Art -->
    <ImageView
        android:id="@+id/albumArt"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:contentDescription="Album Art"
        android:src="@drawable/ic_music_note" />

    <!-- Song Info -->
    <TextView
        android:id="@+id/trackName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/artistName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Favorite Button -->
    <ImageButton
        android:id="@+id/favoriteButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_star_outline"
        android:contentDescription="Add to Favorites"
        android:scaleType="centerInside"
        android:padding="12dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="?android:attr/listDivider" />

    <!-- Play On Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Play on:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="12dp" />

    <!-- Spotify Button -->
    <Button
        android:id="@+id/spotifyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open in Spotify"
        android:textColor="?attr/colorOnSurface"
        android:drawableStart="@drawable/ic_music_note"
        android:drawablePadding="8dp"
        android:paddingVertical="12dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <!-- Apple Music Button -->
    <Button
        android:id="@+id/appleMusicButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Open in Apple Music"
        android:textColor="?attr/colorOnSurface"
        android:drawableStart="@drawable/ic_music_note"
        android:drawablePadding="8dp"
        android:paddingVertical="12dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <!-- YouTube Music Button -->
    <Button
        android:id="@+id/youtubeMusicButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Open in YouTube Music"
        android:textColor="?attr/colorOnSurface"
        android:drawableStart="@drawable/ic_music_note"
        android:drawablePadding="8dp"
        android:paddingVertical="12dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>
