<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- Avatar -->
    <ImageView
        android:id="@+id/imgConversationAvatar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@mipmap/ic_launcher"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- User Name -->
    <TextView
        android:id="@+id/tvConversationUserName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="User Name"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/imgConversationAvatar"
        app:layout_constraintEnd_toStartOf="@id/tvConversationTimestamp"
        app:layout_constraintTop_toTopOf="@id/imgConversationAvatar"/>

    <!-- Last Message -->
    <TextView
        android:id="@+id/tvLastMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Last message preview..."
        android:textSize="14sp"
        android:textColor="#666666"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/imgConversationAvatar"
        app:layout_constraintEnd_toStartOf="@id/tvUnreadBadge"
        app:layout_constraintTop_toBottomOf="@id/tvConversationUserName"/>

    <!-- Timestamp -->
    <TextView
        android:id="@+id/tvConversationTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2h"
        android:textSize="12sp"
        android:textColor="#999999"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvConversationUserName"/>

    <!-- Unread Badge -->
    <TextView
        android:id="@+id/tvUnreadBadge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:text="3"
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_unread_badge"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/imgConversationAvatar"/>

</androidx.constraintlayout.widget.ConstraintLayout>